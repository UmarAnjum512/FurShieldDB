PORT=5000
NODE_ENV=development

MONGO_URI=your_mongodb_atlas_connection_string

JWT_SECRET=your_secure_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s), comma-separated. On Vercel set to your deployed client URL, e.g. https://furshield.vercel.app
CLIENT_URL=http://localhost:5173
# Optional: regex to allow Vercel preview URLs, e.g. ^https://furshield(-.*)?\.vercel\.app$
PREVIEW_ORIGIN_REGEX=

# REQUIRED on Vercel for image/video/document uploads (https://cloudinary.com - free plan)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: password-reset emails (if empty, reset links are not emailed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: AI chat assistant
AI_API_KEY=
AI_MODEL=

# Appointment reminders: secret for GET /api/cron/reminders?key=... and clinic timezone (minutes ahead of UTC; 300 = Pakistan)
CRON_SECRET=
APP_TZ_OFFSET_MINUTES=300

SEED_DEMO_PASSWORD=FurShield123!
